# Environment and local configuration
.env
.env.*
!.env.example
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Test, coverage, and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Local application state
instance/*
!instance/.gitkeep
data/uploads/*
data/exports/*
!data/uploads/.gitkeep
!data/exports/.gitkeep
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.key

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Temporary and log files
.tmp-*
*.tmp
*.log
