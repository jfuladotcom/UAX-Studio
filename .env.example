# Copy this file to .env for local overrides. Never commit .env.

# Local web server. Keep 127.0.0.1 unless you have added authentication and
# intentionally want the app reachable from another device.
AX_HOST=127.0.0.1
AX_PORT=5000

# Local storage. A relative SQLite path is stored inside instance/.
AX_DATABASE_URI=sqlite:///ax_studio.sqlite3
AX_DATA_DIR=data

# Optional. Leave blank to let UAX Studio generate instance/secret.key locally.
# For a fixed value, generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AX_SECRET_KEY=

# Provider settings. The deterministic provider requires no model or API key.
AX_ACTIVE_PROVIDER=deterministic
AX_OLLAMA_BASE_URL=http://127.0.0.1:11434
AX_OLLAMA_MODEL=llama3.1
AX_OLLAMA_TIMEOUT=20

# Set to 0 only when database initialization is managed externally.
AX_AUTO_INIT_DB=1
